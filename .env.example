# Copy this file to .env and fill in your actual API keys.
LLM_API_KEY=your_api_key_here
# Credentials for the LLM-as-a-judge feature (Claude via an OpenAI-compatible gateway).
JUDGE_LLM_API_KEY=your_judge_api_key_here
JUDGE_LLM_BASE_URL=your_openai_compatible_gateway_url_here
# Per-role model selection. If unset, each falls back to the shared LLM_* values,
# so existing setups keep working. Set these to compare models across roles.
# EXTRACTION_LLM_BASE_URL=...
# EXTRACTION_LLM_MODEL_NAME=...
# EXTRACTION_LLM_API_KEY=...
# STANCE_LLM_BASE_URL=...
# STANCE_LLM_MODEL_NAME=...
# STANCE_LLM_API_KEY=...
# Whether stance detection requests vLLM/Qwen "thinking mode"
# (chat_template_kwargs.enable_thinking). Default: true.
# Set to false for OpenAI-compatible backends/proxies (e.g. LiteLLM routing to
# non-vLLM models like DeepSeek) that reject that vLLM-specific field.
# STANCE_LLM_ENABLE_THINKING=true
